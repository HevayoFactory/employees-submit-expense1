{
  "name": "expense-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "expense-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F1.6",
    "F1.7",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4"
  ],
  "description": "The single-page app for employees, managers and finance: submitting claims, reviewing and deciding on them, and exporting approved claims to payroll. Holds no business logic of its own — every read and write goes through expense-api or receipt-agent.",
  "dependencies": [
    {
      "kind": "component",
      "name": "expense-api",
      "description": "Claims, line items, approvals and payroll export.",
      "wiring": {
        "endpoint": {
          "component": "employees-submit-expense-expense-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "EXPENSE_API_URL"
          }
        }
      }
    },
    {
      "kind": "component",
      "name": "receipt-agent",
      "description": "Pre-fills a line item from an uploaded receipt.",
      "wiring": {
        "endpoint": {
          "component": "employees-submit-expense-receipt-agent",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "RECEIPT_AGENT_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Signs employees, managers and finance in.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "employees-submit-fe4a993d",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
