{
  "name": "expense-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "expense-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.4",
    "F1.5",
    "F1.6",
    "F1.7",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4"
  ],
  "description": "Owns expense claims, their line items, approval decisions and payroll export batches. Serves the employee's own claims, a manager's direct reports' claims, and finance's approved-but-unexported claims. Does not read receipts or extract data from them — that is the receipt agent's job.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "expense-db",
      "description": "Stores employees, claims, line items and export batches.",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "employees-submit-c24128d2",
        "envBindings": {
          "dbname": "EXPENSE_DB_DBNAME",
          "host": "EXPENSE_DB_HOST",
          "password": "EXPENSE_DB_PASSWORD",
          "port": "EXPENSE_DB_PORT",
          "user": "EXPENSE_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Validates the signed-in caller's token for every protected operation.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "employees-submit-fe4a993d",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
