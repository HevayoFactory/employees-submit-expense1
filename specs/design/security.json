{
  "version": 3,
  "permissions": [
    {
      "resource": "claims",
      "component": "expense-api",
      "description": "Expense claims and their line items",
      "actions": [
        { "handle": "read", "description": "The caller's own claims" },
        { "handle": "submit", "description": "Create or resubmit a claim" },
        { "handle": "review", "description": "The claims of the caller's direct reports" },
        { "handle": "approve", "description": "Approve a direct report's claim" },
        { "handle": "reject", "description": "Reject a direct report's claim" },
        { "handle": "read-all", "description": "Every approved claim, for export" }
      ]
    },
    {
      "resource": "export-batches",
      "component": "expense-api",
      "description": "Payroll export batches",
      "actions": [
        { "handle": "create", "description": "Export approved claims as a batch" },
        { "handle": "read", "description": "Past export batches" }
      ]
    }
  ],
  "groups": [
    { "name": "Employees", "description": "Everyone who submits expense claims" },
    { "name": "Managers", "description": "People who approve their direct reports' claims" },
    { "name": "Finance", "description": "People who export approved claims to payroll" }
  ],
  "roles": [
    {
      "name": "Employee",
      "description": "Submits expense claims and tracks their status.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F1.5", "F1.6", "F1.7"],
      "grants": ["claims:read", "claims:submit"],
      "assignTo": ["Employees"]
    },
    {
      "name": "Manager",
      "description": "Reviews and decides their direct reports' claims.",
      "stories": ["F2.1", "F2.2", "F2.3", "F2.4"],
      "grants": ["claims:review", "claims:approve", "claims:reject"],
      "assignTo": ["Managers"]
    },
    {
      "name": "FinanceReviewer",
      "description": "Exports approved claims to payroll.",
      "stories": ["F3.1", "F3.2", "F3.3", "F3.4"],
      "grants": ["claims:read-all", "export-batches:create", "export-batches:read"],
      "assignTo": ["Finance"]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "roles": ["Employee"] },
    { "username": "test-employee-2", "roles": ["Employee"] },
    { "username": "test-manager", "roles": ["Manager"] },
    { "username": "test-manager-2", "roles": ["Manager"] },
    { "username": "test-financereviewer", "roles": ["FinanceReviewer"] }
  ]
}
